<mxfile host="app.diagrams.net" type="device">
  <diagram id="mlops-arch" name="MLOps Architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Lifecycle banner ===== -->
        <mxCell id="b1" value="Process Data" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#E8820C;strokeColor=none;fontColor=#1A1A1A;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Develop Model" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#3B3B98;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="30" width="370" height="54" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Deploy" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#A01B5B;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="30" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="Monitor" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#16A085;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1045" y="30" width="305" height="54" as="geometry" />
        </mxCell>

        <!-- ===== Outer lifecycle border ===== -->
        <mxCell id="outer" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1310" height="900" as="geometry" />
        </mxCell>

        <!-- ===== Feature store (Gold, offline) ===== -->
        <mxCell id="fs" value="Feature Store (Gold · Offline)&lt;br&gt;feature_store + label_store&lt;br&gt;&lt;i&gt;point-in-time join&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#CFE8FC;strokeColor=#1C78C0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="585" y="150" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Model registry ===== -->
        <mxCell id="reg" value="Model Registry&lt;br&gt;model_store/ · &lt;b&gt;champion.json&lt;/b&gt;&lt;br&gt;model.pkl · metadata · SHAP&lt;br&gt;optuna.db (study)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#DCEDC8;strokeColor=#558B2F;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="840" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- ===== Process Data group ===== -->
        <mxCell id="pd" value="Process Data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E8820C;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=18;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="collect" value="Collect Data&lt;br&gt;&lt;br&gt;4 CSV sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="615" width="120" height="125" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="Preprocess&lt;br&gt;&lt;br&gt;Bronze → Silver&lt;br&gt;clean · YAML-validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9CCC65;strokeColor=#558B2F;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="230" y="610" width="160" height="135" as="geometry" />
        </mxCell>
        <mxCell id="eng" value="Engineer Features&lt;br&gt;&lt;br&gt;Gold (build_gold)&lt;br&gt;70 features + labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="410" y="610" width="160" height="135" as="geometry" />
        </mxCell>

        <!-- ===== Train / Tune / Evaluate ===== -->
        <mxCell id="train" value="Train · Tune · Evaluate&lt;br&gt;&lt;br&gt;Optuna TPE 50× · 5-fold CV&lt;br&gt;LR / RF / XGBoost&lt;br&gt;SHAP explainability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B3B98;strokeColor=#1A1A6E;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="640" y="605" width="170" height="140" as="geometry" />
        </mxCell>

        <!-- ===== Deploy ===== -->
        <mxCell id="deploy" value="Deploy&lt;br&gt;&lt;br&gt;Batch Inference&lt;br&gt;(inference_pipeline)&lt;br&gt;load champion · score Gold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A01B5B;strokeColor=#6A0E3C;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="605" width="170" height="140" as="geometry" />
        </mxCell>

        <!-- ===== Application / predictions ===== -->
        <mxCell id="app" value="Predictions (Gold)&lt;br&gt;schema-validated&lt;br&gt;→ downstream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A57;strokeColor=#0D1F30;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1130" y="560" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- ===== Monitor ===== -->
        <mxCell id="monitor" value="Monitor&lt;br&gt;AUC / Gini vs actuals&lt;br&gt;PSI drift · bad-rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A085;strokeColor=#0E6B57;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1130" y="680" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Alarm + Scheduler ===== -->
        <mxCell id="alarm" value="Alarm Manager&lt;br&gt;PSI &gt; 0.25 → retrain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="805" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="Scheduler&lt;br&gt;Airflow DAG&lt;br&gt;@monthly · catchup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2C5AA0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="890" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Solid flow edges ===== -->
        <mxCell id="e_cp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="collect" target="prep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="prep" target="eng"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_et" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="eng" target="train"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_td" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="train" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_da" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="deploy" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_dm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=2;" edge="1" parent="1" source="deploy" target="monitor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ma" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1A1A1A;strokeWidth=1;" edge="1" parent="1" source="monitor" target="alarm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Store / fetch features (dashed) ===== -->
        <mxCell id="e_sf" value="Store Features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#E8820C;fontColor=#B45309;fontSize=13;" edge="1" parent="1" source="eng" target="fs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fft" value="Fetch Features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#C2185B;fontColor=#C2185B;fontSize=13;" edge="1" parent="1" source="fs" target="train"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ffd" value="Fetch Features (batch)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#1C78C0;fontColor=#1C78C0;fontSize=13;" edge="1" parent="1" source="fs" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Artifacts (dashed) ===== -->
        <mxCell id="e_sa" value="Store Artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#3B3B98;fontColor=#3B3B98;fontSize=13;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="train" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fa" value="Fetch champion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=13;" edge="1" parent="1" source="reg" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Feedback loops (dashed grey) ===== -->
        <mxCell id="e_drift" value="Model Drift → Retrain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#607D8B;fontColor=#455A64;fontSize=13;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="alarm" target="train"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="837" /></Array></mxGeometry></mxCell>
        <mxCell id="e_perf" value="Performance Feedback Loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#607D8B;fontColor=#455A64;fontSize=13;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="train" target="prep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="790" /></Array></mxGeometry></mxCell>

        <!-- ===== Scheduler orchestration (dashed) ===== -->
        <mxCell id="e_sch" value="orchestrates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#2C5AA0;fontColor=#2C5AA0;fontSize=12;" edge="1" parent="1" source="sched" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
