FROM apache/airflow:2.10.4-python3.12

# Java is required by PySpark tasks that run inside Airflow workers
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends default-jdk-headless procps && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

USER airflow
COPY requirements_airflow.txt ./
RUN pip install --no-cache-dir -r requirements_airflow.txt
