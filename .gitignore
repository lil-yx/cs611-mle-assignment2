# raw data files (provided separately, included in the submission zip)
data/

# generated medallion datamart output
datamart/

# model bank: only the tuned Optuna studies are versioned, so a fresh run
# skips the 2h search but still trains, evaluates and registers a champion
model_store/*
!model_store/optuna.db

# runtime output
logs/
airflow_home/logs/
airflow_home/*.pid
airflow_home/*.db
# regenerated by Airflow on start; contains a webserver secret_key
airflow_home/airflow.cfg

# python / jupyter artefacts
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# course materials and classmates' sample submissions
Assignment 1.pdf
Assignment 2.pdf
sample_assignments/

# local virtual environment
.venv/
